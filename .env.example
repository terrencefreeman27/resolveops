# Copy to .env (optional). No secrets are required for demo mode.
# AI mode: demo (deterministic simulated AI, no keys) | live (reviewers' requests go to Claude; needs ANTHROPIC_API_KEY)
AI_MODE=demo
# Postgres credentials for the local compose database (local-only defaults).
POSTGRES_USER=resolveops
POSTGRES_PASSWORD=resolveops
POSTGRES_DB=resolveops
# Seeded reviewer login (local demo only; change for anything shared).
SEED_REVIEWER_EMAIL=reviewer@northstar.example
SEED_REVIEWER_PASSWORD=northstar-demo
# Host ports
WEB_PORT=8080
API_PORT=8000
# Live mode — leave empty in demo mode. Never commit a real key (.env is gitignored).
ANTHROPIC_API_KEY=
# Optional live settings (defaults shown). See README "Live mode" and docs/DECISIONS.md D16-D21.
# LIVE_MODEL=claude-opus-5-5
# LIVE_EFFORT=medium
# LIVE_REFUSAL_FALLBACK=true
# LIVE_ALLOW_VISITORS=false
# LIVE_MAX_OUTPUT_TOKENS=8000
# LIVE_MAX_TOOL_STEPS=6
# LIVE_MAX_TOKENS_PER_REQUEST=150000
# LIVE_CALL_TIMEOUT_S=120
# LIVE_MAX_RETRIES=2
# LIVE_RATE_PER_REVIEWER_PER_MIN=5
# LIVE_RATE_GLOBAL_PER_MIN=20
# LIVE_MAX_CONCURRENCY=2
# LIVE_MONTHLY_TOKEN_BUDGET=2000000
# USD budget only applies when both prices are set; nothing is assumed.
# LIVE_PRICE_INPUT_PER_MTOK=
# LIVE_PRICE_OUTPUT_PER_MTOK=
# LIVE_MONTHLY_USD_BUDGET=

# --- Workspaces and documents (Milestone 3) ---
# MAX_UPLOAD_BYTES=200000            # per imported .md / .txt document
# MAX_DOCUMENTS_PER_WORKSPACE=40
# MAX_WORKSPACES_PER_REVIEWER=10
# RETRIEVAL_MIN_SCORE=0.72           # evidence check: below this, documentation counts as insufficient

# --- Optional GitHub Issues adapter (Milestone 4) --- see README "Optional GitHub Issues integration".
# Use a dedicated test repository and a fine-grained token scoped to that one repo with
# Issues: Read and write only. Never commit the token. Visitor sandboxes never use GitHub.
GITHUB_ADAPTER_ENABLED=false
GITHUB_TOKEN=
# GITHUB_ISSUES_REPO=owner/resolveops-test     # the only destination; must also be in the allowlist
# GITHUB_ALLOWED_REPOS=owner/resolveops-test   # comma-separated
# GITHUB_LABELS=resolveops,synthetic-test      # optional; needs push access or GitHub drops them
# GITHUB_TIMEOUT_S=10
# GITHUB_MAX_ATTEMPTS=3
# GITHUB_RETRY_BASE_DELAY_S=1
# GITHUB_MAX_WAIT_S=10
