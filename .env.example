# Copy to .env (optional). No secrets are required for demo mode.
# AI mode: demo (deterministic simulated AI, no keys) | live (Milestone 2, needs ANTHROPIC_API_KEY)
AI_MODE=demo
# Postgres credentials for the local compose database (local-only defaults).
POSTGRES_USER=resolveops
POSTGRES_PASSWORD=resolveops
POSTGRES_DB=resolveops
# Seeded reviewer login (local demo only; change for anything shared).
SEED_REVIEWER_EMAIL=reviewer@northstar.example
SEED_REVIEWER_PASSWORD=northstar-demo
# Host ports
WEB_PORT=8080
API_PORT=8000
# Live mode (Milestone 2) — leave empty in demo mode. Never commit a real key.
ANTHROPIC_API_KEY=
